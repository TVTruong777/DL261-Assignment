# Data (downloaded, not committed)
data/
!data/.gitkeep

# Checkpoints (large binaries — host separately, see checkpoints/README.md)
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/README.md

# Results produced by runs (keep the tracked log, ignore raw run dirs)
results/runs/
results/*.png

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Experiment tracking (if used)
wandb/
lightning_logs/
